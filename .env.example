# Copy to .env and fill in. Never commit .env.

# Home Assistant. Long-lived token from the non-admin "eink" HA user.
# Local dev (Mac): HA over Tailscale by IP (Docker Desktop cannot resolve MagicDNS).
# Server (LXC): the LAN URL, http://192.168.0.118:8123
HA_URL=http://100.124.250.57:8123
HA_TOKEN=

# MQTT (Mosquitto add-on accepts HA users) — used for device health entities.
MQTT_HOST=192.168.0.118
MQTT_USER=eink
MQTT_PASS=

# iWindsurf account (for the pro forecast + live station readings)
IWINDSURF_USER=
IWINDSURF_PASS=

# Outlook summarizer
OPENAI_API_KEY=
SUMMARY_MODEL=gpt-5.6-luna

# URL the display uses to reach this service (image links in /api/display).
PUBLIC_URL=http://192.168.0.60:8080

# Optional comma-separated MACs allowed to register via /api/setup. Empty = allow any.
ALLOWED_MACS=
